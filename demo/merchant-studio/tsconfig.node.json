{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist/config",
    "tsBuildInfoFile": "dist/config/tsconfig.node.tsbuildinfo"
  },
  "include": ["vite.config.ts"]
}
