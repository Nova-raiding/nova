node_modules/
dist/
# Machine-local Keychain helper builds must not enter source archives.
**/mcp/keychain-credential-helper
**/mcp/keychain-credential-helper.build.json
**/mcp/.keychain-build-*/
.env
.env.*
!.env.example
coverage/
.DS_Store
*.tsbuildinfo
.gstack/

# Runtime captures, browser screenshots and local inventories are generated
# evidence, not source. Existing reviewed evidence remains tracked; new evidence
# belongs in the external evidence store unless it is explicitly force-added.
/artifacts/**
/screenshots/**
/dogfood/ops-101-public/**
/dogfood/merchant-local-*/**
/dogfood/ops-console/screenshots/**
/dogfood/chatgpt-all-functions/*-inventory.json
/merchant-all-inventory.json
/merchant-interactions.json
/merchant-inventory.json
/ops-all-inventory.json
/ops-inventory.json
/ops-users-result.json
/ops-workspace-visual-inventory.json
/output/**
/tmp/**

# Ephemeral local/runtime outputs. Reviewed evidence remains trackable under
# explicitly named audit directories.
/artifacts/codex-output/
/artifacts/ops-jit-isolation/
/artifacts/isolated-postgres/
/artifacts/deployment-candidates/
/artifacts/customer-delivery-account-access/
/artifacts/customer-delivery-contract-link/
/artifacts/local-runtime-tests/
/artifacts/local-worker-sync/

# Local-only state that must never ship in a clone: Redis persistence dumps,
# the repair scratch directory, a stray codegraph index, competitor research
# notes, and the vitest run marker. None of these are deliverables.
/redis-aof-backup-*.tar.gz
/.codex-redis-repair-test/
# `backup-postgres.sh` defaults BACKUP_DIR to `./backups`, i.e. the working
# directory it is run from — the runbook runs it from the repository root. Those
# archives are unencrypted merchant data, so a clone must never be able to
# stage one by accident.
/backups/
/report-source.md
/.codegraph.db
/test-results/

__pycache__/
*.py[cod]

# TypeScript outputs belong in dist/. Keeping emitted artifacts beside src/*.ts
# makes NodeNext/Vitest resolve stale JavaScript ahead of the authoritative TS.
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map

# In-place mutation gate lock (scripts/invariant-mutation-gate.ts)
.invariants-verify.lock

# Browser-QA screenshots under dogfood are generated by the specs, like the
# root /screenshots/** tree; only /dogfood/ops-console/** was covered before.
/dogfood/*/screenshots/
