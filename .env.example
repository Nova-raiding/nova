NODE_ENV=development
REQUEST_OBSERVABILITY_LOGS=false
# 仅本机 development/test 可使用 local；staging/preview/production 必须使用 strict。
AUTH_ENFORCEMENT=local
# HMAC key used only to fingerprint session IDs; never reuse OIDC or API tokens.
SESSION_ID_HASH_SECRET=replace-with-32-byte-secret
# Bearer required by `GET /metrics` when NODE_ENV=production. Leave blank locally:
# the production branch is the only one that enforces it, so development scrapes
# still answer 200. In staging/preview/production a missing value makes the route
# return 503 METRICS_AUTH_NOT_CONFIGURED and every merchant_* series stays empty
# — silently, with no other symptom. Inject it through the secret manager as the
# METRICS_AUTH_TOKEN key of merchant-runtime-secrets, and give the scraper the
# same value; see infra/observability/prometheus-scrape.example.yaml.
METRICS_AUTH_TOKEN=
PORT=8787
# Installed desktop plugins use local stdio and exchange the signed-in merchant
# session for a short-lived, workspace-bound bearer. Set remote_oauth only when
# the public /mcp endpoint is separately registered as a remote OpenAI App.
MCP_INTEGRATION_MODE=local_stdio
MCP_OAUTH_REQUIRED=false
MCP_OAUTH_ISSUER=
MCP_OAUTH_AUTHORIZATION_ENDPOINT=
MCP_OAUTH_TOKEN_ENDPOINT=
MCP_OAUTH_CLIENTS=
# OpenAI Apps domain verification challenge. Keep blank until the exact token
# issued by OpenAI is injected through the production secret manager.
OPENAI_APPS_CHALLENGE_TOKEN=
# Alipay upstream/internal callback timeout (1–120 seconds). Keep the default
# unless the payment provider's approved SLO requires a different value.
ALIPAY_REQUEST_TIMEOUT_MS=10000
# Production API auth: JSON map of opaque bearer token -> permitted workspaces.
# Example: {"replace-with-secret":["ws_demo"]}; inject via secret manager.
API_AUTH_TOKENS={}
# Platform password accounts are provisioned with a precomputed Argon2id
# hash. Never put the clear-text password in deployment configuration.
PLATFORM_ACCOUNT_LOGIN=
PLATFORM_ACCOUNT_PASSWORD_HASH=
# Managed ops auth: set OPS_AUTH_MODE=oidc in production and inject this secret
# into the SSO gateway and API.
OPS_AUTH_MODE=bearer
OIDC_PROXY_SIGNING_SECRET=
# Shared callback base/template. `/v1/oauth/callback` automatically appends
# the platform; `{platform}` is also supported. Per-platform values override it.
PUBLIC_OAUTH_REDIRECT_URI=
WORKER_API_BASE_URL=
# API-only role credential map. Required in staging/preview/production.
# Each worker receives only its own matching WORKER_API_TOKEN and
# WORKER_API_SIGNING_SECRET through the secret manager.
# A role may temporarily use [current, previous] (maximum two entries) during
# zero-downtime rotation. Tokens and signing secrets must be globally unique.
# Example: {"generation":{"token":"...","signing_secret":"..."},"publish":{"token":"...","signing_secret":"..."},"reconcile":{"token":"...","signing_secret":"..."},"sync":{"token":"...","signing_secret":"..."},"automation":{"token":"...","signing_secret":"..."}}
WORKER_API_CREDENTIALS={}
WORKER_SCAN_API_TOKEN=
WORKER_SCAN_API_SIGNING_SECRET=
WORKER_API_TOKEN=
WORKER_API_SIGNING_SECRET=
# The ECS pilot compose layer pins one credential pair per worker role and
# refuses to render without it (`${WORKER_<ROLE>_API_TOKEN:?}`). The five pairs
# below are that layer's contract, not a second copy of the JSON map above: an
# operator who prepared the map alone still stopped at
# `required variable WORKER_SYNC_API_TOKEN is missing a value` during the
# production render, because nothing in the template named the key.
WORKER_SYNC_API_TOKEN=
WORKER_SYNC_API_SIGNING_SECRET=
WORKER_GENERATION_API_TOKEN=
WORKER_GENERATION_API_SIGNING_SECRET=
WORKER_PUBLISH_API_TOKEN=
WORKER_PUBLISH_API_SIGNING_SECRET=
WORKER_RECONCILE_API_TOKEN=
WORKER_RECONCILE_API_SIGNING_SECRET=
WORKER_AUTOMATION_API_TOKEN=
WORKER_AUTOMATION_API_SIGNING_SECRET=
# `auto` (every workspace the role may reach) or an explicit production
# workspace allowlist. The ECS pilot compose refuses a blank value.
WORKER_WORKSPACES=
DATABASE_URL=memory://local
# Dedicated connection string for the ops console and the migration runner.
# The ECS pilot compose requires it separately from DATABASE_URL, and
# infra/scripts/deploy-preflight-ecs.sh rejects a localhost value.
OPS_DATABASE_URL=
# Uniform logical object-byte quota applied independently to each workspace.
# Current published monthly plans include 50 decimal GB, so use 50000000000.
# This is a runtime safety ceiling, not a replacement for per-order/SKU benefits;
# do not raise it for a custom contract until entitlement-driven quotas exist.
ASSET_STORAGE_QUOTA_BYTES=
# Production/staging object storage must be remote, TLS-protected and KMS-backed.
# Local Compose supplies its own acceptance-only values; these are intentionally blank.
ASSET_STORAGE_BUCKET=
ASSET_STORAGE_REGION=
ASSET_STORAGE_ENDPOINT=
ASSET_STORAGE_KMS_KEY_ID=
ASSET_STORAGE_SSE_MODE=AES256
ASSET_STORAGE_CREDENTIAL_PROVIDER=aliyun_ecs_ram_role
ASSET_STORAGE_ECS_RAM_ROLE=
# ACK only: set ASSET_STORAGE_CREDENTIAL_PROVIDER=aliyun_ack_rrsa. Do not set
# these manually; ack-pod-identity-webhook injects the three RRSA variables.
# ALIBABA_CLOUD_ROLE_ARN=
# ALIBABA_CLOUD_OIDC_PROVIDER_ARN=
# ALIBABA_CLOUD_OIDC_TOKEN_FILE=/var/run/secrets/ack.alibabacloud.com/rrsa-tokens/token
# Production readiness reads the OSS bucket-level versioning/lifecycle
# declarations below. Keep them explicit so a deployed bucket policy can be
# audited against the values reported by /readyz.
OBJECT_STORAGE_VERSIONING=false
DATA_RETENTION_DAYS=
ASSET_QUARANTINE_RETENTION_DAYS=
ASSET_CLEAN_RETENTION_DAYS=
DELETION_REQUEST_GRACE_DAYS=
BACKUP_RETENTION_DAYS=
LIFECYCLE_POLICY_REF=
ALERT_CHANNEL_SECRET_REF=
# Scanner receipts are signed by the worker and accepted only from an
# explicitly approved service identity with a minimum ClamAV definition floor.
ASSET_SCANNER_SERVICE_ID=merchant-asset-scanner-local
ASSET_SCAN_APPROVED_SCANNER_SERVICE_IDS=merchant-asset-scanner-local,merchant-asset-scanner
ASSET_SCAN_MIN_DEFINITIONS_VERSION=28000
ASSET_SCAN_POLICY_VERSION=local-real-scan-v1
ASSET_SCAN_TRUSTED_PUBLIC_KEYS=
ASSET_SCAN_RECEIPT_KEY_ID=local-scanner-key
ASSET_SCAN_RECEIPT_PRIVATE_KEY_PEM_B64=
# Bearer the asset scanner worker presents to the API, and the secret that
# signs its workspace-bound requests. Production pins both on the scanner
# service (`${ASSET_SCANNER_API_TOKEN:?}`), which is why a blank pair aborts the
# ECS pilot render rather than degrading to a local fixture.
ASSET_SCANNER_API_TOKEN=
ASSET_SCANNER_WORKSPACE_SIGNING_SECRET=
# Primary key pair for the public, short-lived asset display URLs the API
# hands to the merchant UI. The ECS pilot compose pins both names, so the
# template has to declare them next to the storage block they sign for.
# `ASSET_DISPLAY_URL_PREVIOUS_KEYS_JSON` is the optional rotation window.
ASSET_DISPLAY_URL_SIGNING_SECRET=
ASSET_DISPLAY_URL_SIGNING_KEY_ID=
# Production/staging should run migrations as a separate owner role and set
# this to false for the least-privileged API/worker database role.
RUN_MIGRATIONS_ON_STARTUP=true
REDIS_URL=memory://local
WORKER_POLL_INTERVAL_MS=1000
STORAGE_RECONCILIATION_INTERVAL_MS=900000
PAYMENT_RECONCILIATION_INTERVAL_MS=300000
PAYMENT_RECONCILIATION_BATCH_SIZE=10
API_RATE_LIMIT_PER_MINUTE=120
OPS_API_RATE_LIMIT_PER_MINUTE=600
PLUGIN_WRITE_ENABLED=false
# ChatGPT/Codex 插件桥接配置。地址必须是 API 的 root origin；生产环境改为
# HTTPS 并由 Secret Manager 注入 token。默认关闭 fixture 回退和写操作。
MERCHANT_MCP_BASE_URL=http://127.0.0.1:8787
MERCHANT_MCP_TOKEN=
MERCHANT_WORKSPACE_ID=
# Bearer the public pilot gateway uses for its own preflight call into the API.
# The ECS pilot compose pins it (`${MERCHANT_API_TOKEN:?}`) alongside the
# workspace id above, so a pilot `.env` that carries only the workspace id stops
# at the Compose render.
MERCHANT_API_TOKEN=
MERCHANT_STRICT_AUTH=false
MERCHANT_ALLOW_FIXTURE_FALLBACK=false
MERCHANT_MCP_WRITE_ENABLED=false
# All text, image, vision and video traffic must use this HTTPS relay.
# Direct provider endpoints/keys are intentionally unsupported.
MODEL_RELAY_BASE_URL=
MODEL_RELAY_API_KEY=
# Optional read-only Wormhole/New API account used by billing.model-usage.statement.
# These are user-session credentials for /api/log/self, not the model API key.
MODEL_RELAY_LOG_BASE_URL=https://ai.wormholexyz.xyz
MODEL_RELAY_LOG_USER_TOKEN=
MODEL_RELAY_LOG_REFRESH_COOKIE=
MODEL_RELAY_LOG_SESSION_FILE=
MODEL_RELAY_LOG_USER_ID=
# Production must pin the relay to exact reviewed hostnames; comma-separated.
MODEL_RELAY_ALLOWED_HOSTS=
# Optional audited fallback when the relay receipt has usage but no cost_cny.
# The relay must expose HTTPS /api/pricing and /api/status snapshots.
MODEL_RELAY_PRICING_DERIVATION_ENABLED=false
MODEL_RELAY_PRICING_GROUP=
# Never silently fall back to default. Configure the exact approved relay group per modality.
MODEL_RELAY_TEXT_PRICING_GROUP=VIP
MODEL_RELAY_OCR_PRICING_GROUP=VIP
MODEL_RELAY_IMAGE_PRICING_GROUP=VIP
MODEL_RELAY_IMAGE_EDIT_PRICING_GROUP=VIP
MODEL_RELAY_VIDEO_PRICING_GROUP=VIP
MODEL_RELAY_VIDEO_PRICING_OVERRIDES='{"wan3.0-video":0.25}'
MODEL_RELAY_COST_EVIDENCE=false
MODEL_RELAY_TEXT_COST_EVIDENCE=false
MODEL_RELAY_OCR_COST_EVIDENCE=false
MODEL_RELAY_IMAGE_COST_EVIDENCE=false
MODEL_RELAY_IMAGE_EDIT_COST_EVIDENCE=false
MODEL_RELAY_VIDEO_COST_EVIDENCE=false
# 可选：视频使用不同计费分组 Token；未设置时回退到 MODEL_RELAY_API_KEY。
VIDEO_MODEL_RELAY_API_KEY=
MODEL_RPM_LIMIT=
MODEL_TPM_LIMIT=
MODEL_DAILY_CNY_LIMIT=
# Production alert delivery is a readiness gate; configure an allow-listed HTTPS
# endpoint and signing secret through the secret manager, never in plugin input.
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_WEBHOOK_ALLOWED_HOSTS=
OPS_ALERT_WEBHOOK_SECRET=
# Required in production. Use a reviewed pricing snapshot/version and conservative
# per-request RMB ceilings; missing or invalid values fail closed before relay use.
MODEL_COST_ESTIMATE_VERSION=
MODEL_TEXT_MAX_REQUEST_CNY=
MODEL_IMAGE_MAX_REQUEST_CNY=
MODEL_IMAGE_EDIT_MAX_REQUEST_CNY=
MODEL_OCR_MAX_REQUEST_CNY=
MODEL_VIDEO_MAX_REQUEST_CNY=
AI_MODEL=glm-4.7-flash
AI_TIMEOUT_MS=90000
# Hard per-request budgets. Invalid values fail closed instead of disabling the limit.
AI_MAX_INPUT_TOKENS=4000
AI_MAX_OUTPUT_TOKENS=2500
IMAGE_MODEL=
IMAGE_GENERATION_PATH=/images/generations
IMAGE_EDIT_MODEL=
IMAGE_EDIT_PATH=/images/edits
OCR_MODEL=
VIDEO_MODEL=
# Reference-image video requires an explicitly configured image-capable model.
VIDEO_IMAGE_MODEL=
VIDEO_RESOLUTION=1080P
# json for Wan native first-frame media; openai-video for compatible file-upload providers.
VIDEO_REQUEST_FORMAT=json
VIDEO_DURATION_SECONDS=100
VIDEO_GENERATION_PATH=/video/generations
VIDEO_STATUS_PATH=/video/generations/{job_id}
# Production/staging must pin provider artifact downloads to exact reviewed hosts.
VIDEO_ARTIFACT_ALLOWED_HOSTS=
IMAGE_ARTIFACT_ALLOWED_HOSTS=
VIDEO_TIMEOUT_MS=300000
IMAGE_TIMEOUT_MS=120000
IMAGE_EDIT_TIMEOUT_MS=300000
IMAGE_SIZE=1024x1024
IMAGE_QUALITY=medium
# Prefer provider-owned HTTPS URLs; the API persists fetched results to object storage.
IMAGE_RESPONSE_FORMAT=url
# Real image/edit/video canaries may incur provider charges and are disabled by
# default. Set this only for a reviewed, disposable canary run; never enable it
# in the plugin or user-controlled input path.
MODEL_RELAY_CANARY_CONFIRM=false
IMAGE_OUTPUT_FORMAT=png
# Billing/payment. `fixture` is local-only; production must use official provider APIs and signed callbacks.
PAYMENT_MODE=fixture
PAYMENT_PROVIDER_ADAPTERS=alipay
# Alipay merchant application id. The ECS pilot compose forwards it to the
# payment gateway as `${ALIPAY_APP_ID:?}`; the private key and certificate stay
# in that gateway and never reach this service.
ALIPAY_APP_ID=
# Public HTTPS base URL the merchant UI sends the buyer to for checkout. It is
# declared separately from PAYMENT_CALLBACK_BASE_URL because the pilot layer
# requires both and they are different public origins.
PAYMENT_CHECKOUT_BASE_URL=
PAYMENT_CALLBACK_BASE_URL=
PAYMENT_PROVIDER_CHECKOUT_API_URL=
PAYMENT_PROVIDER_QUERY_API_URL=
PAYMENT_PROVIDER_REFUND_QUERY_API_URL=
PAYMENT_PROVIDER_REFUND_API_URL=
PAYMENT_PROVIDER_API_KEY=
PAYMENT_PROVIDER_MERCHANT_ID=
PAYMENT_CALLBACK_SECRET=
PAYMENT_RECONCILIATION_ENABLED=false
PAYMENT_REFUND_ENABLED=false
# Channel label stored on `commercial_orders.payment_provider` for V2 commercial
# orders. This is NOT the same switch as PAYMENT_MODE: the API reads it before
# it creates the order, so when it is unset `commercial.order.create` fails with
# 503 COMMERCIAL_PAYMENT_PROVIDER_UNAVAILABLE and no order row is written — the
# operator's `ops.commercial.order.payment.verify` then finds nothing to verify.
# Production rejects `sandbox`; use the real channel (`alipay`/`wechat`) or
# `manual_transfer` for offline transfer verified by an operator.
COMMERCIAL_PAYMENT_PROVIDER=manual_transfer
# 支付宝/微信原生商户私钥和证书只配置在独立支付网关，不进入本服务。
# Release evidence paths are required by deploy-preflight and must point to
# immutable, release-bound artifacts. Leave blank for local development.
PRODUCTION_CONFIG_PATH=
CAPABILITY_EVIDENCE_PATH=
CAPACITY_REPORT_PATH=
MODEL_RELAY_EVIDENCE_PATH=
CODEX_APP_HOST_EVIDENCE_PATH=
OBJECT_STORAGE_EVIDENCE_PATH=
PAYMENT_EVIDENCE_PATH=
RESTORE_EVIDENCE_PATH=
PRODUCTION_EVIDENCE_ARTIFACT_ROOT=
# Platform read/write switches. Only JD, TAOBAO and DOUYIN are actually read:
# `buildHttpConnectorConfigs` derives the switch prefix as
# JD | TAOBAO (taobao and tmall share the TAOBAO switches) | DOUYIN and leaves
# pinduoduo/xiaohongshu without one. The TMALL_*/PDD_*/XHS_* entries below are
# therefore wired to nothing. Where a switch can still be acted on, the config
# build refuses such a configuration instead of ignoring it: with any mode other
# than `manual`, setting one of them to `true` raises UnwiredPlatformSwitchError
# and names the key that does work, e.g.
#   "TMALL_WRITE_ENABLED=true does nothing: tmall is controlled by
#    TAOBAO_WRITE_ENABLED. Set TAOBAO_WRITE_ENABLED instead, or remove
#    TMALL_WRITE_ENABLED."
# `PLATFORM_OPERATIONS_MODE=manual` is exempt on purpose: it blocks every
# platform write before any switch is consulted, so a meaningless key there
# cannot mislead anyone, and refusing to boot over it would turn a harmless
# no-op into an outage for a deployment that otherwise starts.
# `false`, empty and unset keep behaving exactly as before, so the compose
# defaults are unaffected. They stay declared because the ECS pilot compose
# forwards the full six-prefix matrix and
# tests/ecs-pilot-api-replica-parity.test.ts pins it; the reader that rejects
# them is registered in tests/env-example-read-gate.test.ts, which otherwise
# fails any declared key that no code path reads.
JD_AUTH_ENABLED=false
JD_READ_ENABLED=false
JD_WRITE_ENABLED=false
TAOBAO_AUTH_ENABLED=false
TAOBAO_READ_ENABLED=false
TAOBAO_WRITE_ENABLED=false
TMALL_AUTH_ENABLED=false
TMALL_READ_ENABLED=false
TMALL_WRITE_ENABLED=false
PDD_AUTH_ENABLED=false
PDD_READ_ENABLED=false
PDD_WRITE_ENABLED=false
XHS_AUTH_ENABLED=false
XHS_READ_ENABLED=false
XHS_WRITE_ENABLED=false
DOUYIN_AUTH_ENABLED=false
DOUYIN_READ_ENABLED=false
DOUYIN_WRITE_ENABLED=false
CONNECTOR_FIXTURE_MODE=false
# Current release uses credential-free human operations for the six commerce
# platforms. Set official_api only after OAuth/API capability evidence exists.
PLATFORM_OPERATIONS_MODE=manual
VAULT_ADDR=
VAULT_TOKEN=
VAULT_KV_MOUNT=secret
VAULT_NAMESPACE=
VAULT_CREDENTIAL_PATH_PREFIX=merchant-marketing
JD_APP_KEY=
JD_APP_SECRET=
JD_OAUTH_AUTHORIZE_URL=
JD_OAUTH_TOKEN_URL=
JD_OAUTH_REDIRECT_URI=
JD_API_BASE_URL=
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_OAUTH_AUTHORIZE_URL=
TAOBAO_OAUTH_TOKEN_URL=
TAOBAO_OAUTH_REDIRECT_URI=
TAOBAO_OAUTH_REFRESH_URL=
TAOBAO_OAUTH_REVOKE_URL=
TAOBAO_OAUTH_SCOPES=
TAOBAO_API_BASE_URL=
PDD_APP_KEY=
PDD_APP_SECRET=
PDD_OAUTH_AUTHORIZE_URL=
PDD_OAUTH_TOKEN_URL=
PDD_OAUTH_REDIRECT_URI=
PDD_API_BASE_URL=
TMALL_CLIENT_ID=
TMALL_CLIENT_SECRET=
TMALL_OAUTH_AUTHORIZE_URL=
TMALL_OAUTH_TOKEN_URL=
TMALL_OAUTH_REDIRECT_URI=
TMALL_OAUTH_REFRESH_URL=
TMALL_OAUTH_REVOKE_URL=
TMALL_OAUTH_SCOPES=
TMALL_API_BASE_URL=
TMALL_SYNC_PATH=/products
TMALL_CREATE_PATH=/products/create
TMALL_UPDATE_PATH=/products/update
TMALL_QUERY_PATH=/publish/status
# Router-gateway API selectors (JD routerjson, Alibaba TOP/淘宝+天猫, Pinduoduo).
# These four platforms select the API with a request parameter, not with the URL
# path, so there is no default and no fallback: an unset selector is a terminal
# NOT_CONFIGURED for that operation. Leave one empty and the whole platform stays
# un-admitted (`API_SELECTOR_MISSING`) rather than shipping a deployment whose
# calls dead-letter. Values must come from the platform's own API documentation.
TMALL_SYNC_METHOD=
TMALL_CREATE_METHOD=
TMALL_UPDATE_METHOD=
TMALL_QUERY_METHOD=
TMALL_MEDIA_METHOD=
JD_SYNC_PATH=/products
JD_CREATE_PATH=/products/create
JD_UPDATE_PATH=/products/update
JD_QUERY_PATH=/publish/status
# Required for JD routerjson: see the router-gateway selector note above.
JD_SYNC_METHOD=
JD_CREATE_METHOD=
JD_UPDATE_METHOD=
JD_QUERY_METHOD=
JD_MEDIA_METHOD=
TAOBAO_SYNC_PATH=/products
TAOBAO_CREATE_PATH=/products/create
TAOBAO_UPDATE_PATH=/products/update
TAOBAO_QUERY_PATH=/publish/status
# Required for Alibaba TOP (shared by 淘宝 and 天猫): see the router-gateway
# selector note above.
TAOBAO_SYNC_METHOD=
TAOBAO_CREATE_METHOD=
TAOBAO_UPDATE_METHOD=
TAOBAO_QUERY_METHOD=
TAOBAO_MEDIA_METHOD=
PDD_SYNC_PATH=/products
PDD_CREATE_PATH=/products/create
PDD_UPDATE_PATH=/products/update
PDD_QUERY_PATH=/publish/status
# Required for Pinduoduo (`type` parameter): see the router-gateway selector
# note above.
PDD_SYNC_METHOD=
PDD_CREATE_METHOD=
PDD_UPDATE_METHOD=
PDD_QUERY_METHOD=
PDD_MEDIA_METHOD=
XHS_CLIENT_ID=
XHS_CLIENT_SECRET=
XHS_OAUTH_AUTHORIZE_URL=
XHS_OAUTH_TOKEN_URL=
XHS_OAUTH_REDIRECT_URI=
XHS_API_BASE_URL=
XHS_SYNC_PATH=/products
XHS_CREATE_PATH=/products/create
XHS_UPDATE_PATH=/products/update
XHS_QUERY_PATH=/publish/status
DOUYIN_CLIENT_ID=
DOUYIN_CLIENT_SECRET=
DOUYIN_OAUTH_AUTHORIZE_URL=
DOUYIN_OAUTH_TOKEN_URL=
DOUYIN_OAUTH_REDIRECT_URI=
DOUYIN_API_BASE_URL=
DOUYIN_SYNC_PATH=/products
DOUYIN_CREATE_PATH=/products/create
DOUYIN_UPDATE_PATH=/products/update
DOUYIN_QUERY_PATH=/publish/status
# Manual platform operations owns rule uploads locally; the production renderer
# disables remote rule sync automatically. These remain empty at runtime.
PLATFORM_RULE_SYNC_MANIFEST_URL=
PLATFORM_RULE_SYNC_SIGNING_SECRET=
PLATFORM_RULE_SYNC_INTERVAL_HOURS=0
# Optional reviewed JSON-path response mapping for social APIs. Leave empty
# until the platform's documented payload and mapping evidence are approved.
XHS_ITEMS_PATH=
XHS_REMOTE_ID_PATH=
XHS_TITLE_PATH=
XHS_DESCRIPTION_PATH=
XHS_PRICE_PATH=
XHS_STOCK_PATH=
XHS_SKU_PATH=
XHS_SKU_ID_PATH=
XHS_SKU_NAME_PATH=
XHS_SKU_PRICE_PATH=
XHS_SKU_STOCK_PATH=
XHS_IMAGES_PATH=
XHS_CATEGORY_PATH=
XHS_ATTRIBUTES_PATH=
XHS_REQUEST_ID_PATH=
XHS_STATE_PATH=
XHS_FOUND_PATH=
DOUYIN_ITEMS_PATH=
DOUYIN_REMOTE_ID_PATH=
DOUYIN_TITLE_PATH=
DOUYIN_DESCRIPTION_PATH=
DOUYIN_PRICE_PATH=
DOUYIN_STOCK_PATH=
DOUYIN_SKU_PATH=
DOUYIN_SKU_ID_PATH=
DOUYIN_SKU_NAME_PATH=
DOUYIN_SKU_PRICE_PATH=
DOUYIN_SKU_STOCK_PATH=
DOUYIN_IMAGES_PATH=
DOUYIN_CATEGORY_PATH=
DOUYIN_ATTRIBUTES_PATH=
DOUYIN_REQUEST_ID_PATH=
DOUYIN_STATE_PATH=
DOUYIN_FOUND_PATH=
OPS_ALERT_NOTIFICATIONS_ENABLED=false
# ECS release image references. The final production Compose layer
# (infra/local/docker-compose.ecs-pilot-release.yml) pins every release artifact
# with `${VAR:?}` and the renderer reads this file through `--env-file .env`, so
# a pinned image whose variable is declared nowhere fails the whole render with
# `required variable <NAME>_IMAGE_REF is missing a value`. The release pipeline
# (outside this repository) builds the images and supplies the immutable
# `repository@sha256:<digest>` references; a tag or a blank value is rejected by
# infra/scripts/deploy-preflight-ecs.sh and validate-ecs-compose-release.rb.
#
# All eight pinned references belong here. Only MIGRATION_IMAGE_REF and
# PILOT_GATEWAY_IMAGE_REF used to be listed, so an operator who built the ECS
# host `.env` from this template — the repository's only env template — then hit
# `error while interpolating services.api.image: required variable
# API_IMAGE_REF is missing a value` and five more, with no way to tell from the
# truncated error text which names were missing. The release pipeline builds and
# pushes these images; this file only has to name them.
MIGRATION_IMAGE_REF=
PILOT_GATEWAY_IMAGE_REF=
API_IMAGE_REF=
WORKER_IMAGE_REF=
UI_IMAGE_REF=
OPS_UI_IMAGE_REF=
PAYMENT_GATEWAY_IMAGE_REF=
CLAMAV_IMAGE_REF=
# Release identity bound into the API/UI containers by the release layer. They
# are produced by the release pipeline (and checked against the staged
# `.candidate-identity` by infra/scripts/deploy-preflight-ecs.sh), never by the
# operator, but the renderer still reads them from this file.
PILOT_RELEASE_ID=
PILOT_RELEASE_GIT_SHA=
PILOT_RELEASE_MANIFEST_SHA256=
PILOT_RELEASE_IMAGE_SET_DIGEST=
