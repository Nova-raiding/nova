NODE_ENV=development
REQUEST_OBSERVABILITY_LOGS=false
# 仅本机 development/test 可使用 local；staging/preview/production 必须使用 strict。
AUTH_ENFORCEMENT=local
# HMAC key used only to fingerprint session IDs; never reuse OIDC or API tokens.
SESSION_ID_HASH_SECRET=replace-with-32-byte-secret
PORT=8787
# Production API auth: JSON map of opaque bearer token -> permitted workspaces.
# Example: {"replace-with-secret":["ws_demo"]}; inject via secret manager.
API_AUTH_TOKENS={}
# Managed ops auth: set OPS_AUTH_MODE=oidc in production and inject this secret
# into the SSO gateway and API.
OPS_AUTH_MODE=bearer
OIDC_PROXY_SIGNING_SECRET=
# Shared callback base/template. `/v1/oauth/callback` automatically appends
# the platform; `{platform}` is also supported. Per-platform values override it.
PUBLIC_OAUTH_REDIRECT_URI=
WORKER_API_BASE_URL=
# API-only role credential map. Required in staging/preview/production.
# Each worker receives only its own matching WORKER_API_TOKEN and
# WORKER_API_SIGNING_SECRET through the secret manager.
# A role may temporarily use [current, previous] (maximum two entries) during
# zero-downtime rotation. Tokens and signing secrets must be globally unique.
# Example: {"generation":{"token":"...","signing_secret":"..."},"publish":{"token":"...","signing_secret":"..."},"reconcile":{"token":"...","signing_secret":"..."},"sync":{"token":"...","signing_secret":"..."},"automation":{"token":"...","signing_secret":"..."}}
WORKER_API_CREDENTIALS={}
WORKER_API_TOKEN=
WORKER_API_SIGNING_SECRET=
DATABASE_URL=memory://local
# Workspace logical object-byte quota; production/staging must set explicitly.
ASSET_STORAGE_QUOTA_BYTES=
# Scanner receipts are signed by the worker and accepted only from an
# explicitly approved service identity with a minimum ClamAV definition floor.
ASSET_SCANNER_SERVICE_ID=merchant-asset-scanner-local
ASSET_SCAN_APPROVED_SCANNER_SERVICE_IDS=merchant-asset-scanner-local,merchant-asset-scanner
ASSET_SCAN_MIN_DEFINITIONS_VERSION=28000
ASSET_SCAN_POLICY_VERSION=local-real-scan-v1
ASSET_SCAN_TRUSTED_PUBLIC_KEYS=
ASSET_SCAN_RECEIPT_KEY_ID=local-scanner-key
ASSET_SCAN_RECEIPT_PRIVATE_KEY_PEM_B64=
# Production/staging should run migrations as a separate owner role and set
# this to false for the least-privileged API/worker database role.
RUN_MIGRATIONS_ON_STARTUP=true
REDIS_URL=memory://local
WORKER_POLL_INTERVAL_MS=1000
STORAGE_RECONCILIATION_INTERVAL_MS=900000
API_RATE_LIMIT_PER_MINUTE=120
OPS_API_RATE_LIMIT_PER_MINUTE=600
PLUGIN_WRITE_ENABLED=false
MODEL_PROVIDER=fake
# All text, image, vision and video traffic must use this HTTPS relay.
# Direct provider endpoints/keys are intentionally unsupported.
MODEL_RELAY_BASE_URL=
MODEL_RELAY_API_KEY=
# Optional read-only Wormhole/New API account used by billing.model-usage.statement.
# These are user-session credentials for /api/log/self, not the model API key.
MODEL_RELAY_LOG_BASE_URL=https://ai.wormholexyz.xyz
MODEL_RELAY_LOG_USER_TOKEN=
MODEL_RELAY_LOG_REFRESH_COOKIE=
MODEL_RELAY_LOG_SESSION_FILE=
MODEL_RELAY_LOG_USER_ID=
# Production must pin the relay to exact reviewed hostnames; comma-separated.
MODEL_RELAY_ALLOWED_HOSTS=
# Optional audited fallback when the relay receipt has usage but no cost_cny.
# The relay must expose HTTPS /api/pricing and /api/status snapshots.
MODEL_RELAY_PRICING_DERIVATION_ENABLED=false
MODEL_RELAY_PRICING_GROUP=
# Never silently fall back to default. Configure the exact approved relay group per modality.
MODEL_RELAY_TEXT_PRICING_GROUP=VIP
MODEL_RELAY_OCR_PRICING_GROUP=VIP
MODEL_RELAY_IMAGE_PRICING_GROUP=VIP
MODEL_RELAY_IMAGE_EDIT_PRICING_GROUP=VIP
MODEL_RELAY_VIDEO_PRICING_GROUP=SVIP
MODEL_RELAY_VIDEO_PRICING_OVERRIDES='{"happyhorse-1.1-t2v":0.4508,"happyhorse-1.1-i2v":0.4508,"happyhorse-1.1-r2v":0.4508,"wan3.0-video":0.25}'
MODEL_RELAY_COST_EVIDENCE=false
MODEL_RELAY_TEXT_COST_EVIDENCE=false
MODEL_RELAY_OCR_COST_EVIDENCE=false
MODEL_RELAY_IMAGE_COST_EVIDENCE=false
MODEL_RELAY_IMAGE_EDIT_COST_EVIDENCE=false
MODEL_RELAY_VIDEO_COST_EVIDENCE=false
# 可选：视频使用不同计费分组 Token；未设置时回退到 MODEL_RELAY_API_KEY。
VIDEO_MODEL_RELAY_API_KEY=
MODEL_RPM_LIMIT=
MODEL_TPM_LIMIT=
MODEL_DAILY_CNY_LIMIT=
# Required in production. Use a reviewed pricing snapshot/version and conservative
# per-request RMB ceilings; missing or invalid values fail closed before relay use.
MODEL_COST_ESTIMATE_VERSION=
MODEL_TEXT_MAX_REQUEST_CNY=
MODEL_IMAGE_MAX_REQUEST_CNY=
MODEL_IMAGE_EDIT_MAX_REQUEST_CNY=
MODEL_OCR_MAX_REQUEST_CNY=
MODEL_VIDEO_MAX_REQUEST_CNY=
AI_MODEL=
AI_TIMEOUT_MS=90000
# Hard per-request budgets. Invalid values fail closed instead of disabling the limit.
AI_MAX_INPUT_TOKENS=4000
AI_MAX_OUTPUT_TOKENS=2500
IMAGE_MODEL=
IMAGE_GENERATION_PATH=/images/generations
IMAGE_EDIT_MODEL=
IMAGE_EDIT_PATH=/images/generations
OCR_MODEL=
VIDEO_MODEL=
VIDEO_DURATION_SECONDS=100
VIDEO_GENERATION_PATH=/video/generations
VIDEO_STATUS_PATH=/video/generations/{job_id}
# Production/staging must pin provider artifact downloads to exact reviewed hosts.
VIDEO_ARTIFACT_ALLOWED_HOSTS=
IMAGE_ARTIFACT_ALLOWED_HOSTS=
VIDEO_TIMEOUT_MS=300000
IMAGE_TIMEOUT_MS=300000
IMAGE_EDIT_TIMEOUT_MS=300000
IMAGE_SIZE=1024x1024
IMAGE_QUALITY=medium
# Prefer provider-owned HTTPS URLs; the API persists fetched results to object storage.
IMAGE_RESPONSE_FORMAT=url
IMAGE_OUTPUT_FORMAT=png
# Billing/payment. `fixture` is local-only; production must use official provider APIs and signed callbacks.
PAYMENT_MODE=fixture
PAYMENT_CALLBACK_BASE_URL=
PAYMENT_PROVIDER_CHECKOUT_API_URL=
PAYMENT_PROVIDER_QUERY_API_URL=
PAYMENT_PROVIDER_REFUND_API_URL=
PAYMENT_PROVIDER_API_KEY=
PAYMENT_PROVIDER_MERCHANT_ID=
# 支付宝/微信原生商户私钥和证书只配置在独立支付网关，不进入本服务。
# Optional internal cost rates; never expose provider keys or raw billing data to merchants.
AI_PRICE_CNY_PER_1K_INPUT_TOKENS=
AI_PRICE_CNY_PER_1K_OUTPUT_TOKENS=
IMAGE_PRICE_CNY_PER_IMAGE=
JD_AUTH_ENABLED=false
JD_READ_ENABLED=false
JD_WRITE_ENABLED=false
TAOBAO_AUTH_ENABLED=false
TAOBAO_READ_ENABLED=false
TAOBAO_WRITE_ENABLED=false
TMALL_AUTH_ENABLED=false
TMALL_READ_ENABLED=false
TMALL_WRITE_ENABLED=false
PDD_AUTH_ENABLED=false
PDD_READ_ENABLED=false
PDD_WRITE_ENABLED=false
XHS_AUTH_ENABLED=false
XHS_READ_ENABLED=false
XHS_WRITE_ENABLED=false
DOUYIN_AUTH_ENABLED=false
DOUYIN_READ_ENABLED=false
DOUYIN_WRITE_ENABLED=false
CONNECTOR_FIXTURE_MODE=false
VAULT_ADDR=
VAULT_TOKEN=
VAULT_KV_MOUNT=secret
VAULT_NAMESPACE=
VAULT_CREDENTIAL_PATH_PREFIX=merchant-marketing
JD_APP_KEY=
JD_APP_SECRET=
JD_OAUTH_AUTHORIZE_URL=
JD_OAUTH_TOKEN_URL=
JD_OAUTH_REDIRECT_URI=
JD_API_BASE_URL=
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_OAUTH_AUTHORIZE_URL=
TAOBAO_OAUTH_TOKEN_URL=
TAOBAO_OAUTH_REDIRECT_URI=
TAOBAO_API_BASE_URL=
PDD_APP_KEY=
PDD_APP_SECRET=
PDD_OAUTH_AUTHORIZE_URL=
PDD_OAUTH_TOKEN_URL=
PDD_OAUTH_REDIRECT_URI=
PDD_API_BASE_URL=
TMALL_CLIENT_ID=
TMALL_CLIENT_SECRET=
TMALL_OAUTH_AUTHORIZE_URL=
TMALL_OAUTH_TOKEN_URL=
TMALL_OAUTH_REDIRECT_URI=
TMALL_OAUTH_REFRESH_URL=
TMALL_OAUTH_REVOKE_URL=
TMALL_OAUTH_SCOPES=
TMALL_API_BASE_URL=
TMALL_SYNC_PATH=/products
TMALL_CREATE_PATH=/products/create
TMALL_UPDATE_PATH=/products/update
TMALL_QUERY_PATH=/publish/status
JD_SYNC_PATH=/products
JD_CREATE_PATH=/products/create
JD_UPDATE_PATH=/products/update
JD_QUERY_PATH=/publish/status
TAOBAO_SYNC_PATH=/products
TAOBAO_CREATE_PATH=/products/create
TAOBAO_UPDATE_PATH=/products/update
TAOBAO_QUERY_PATH=/publish/status
PDD_SYNC_PATH=/products
PDD_CREATE_PATH=/products/create
PDD_UPDATE_PATH=/products/update
PDD_QUERY_PATH=/publish/status
XHS_CLIENT_ID=
XHS_CLIENT_SECRET=
XHS_OAUTH_AUTHORIZE_URL=
XHS_OAUTH_TOKEN_URL=
XHS_OAUTH_REDIRECT_URI=
XHS_API_BASE_URL=
XHS_SYNC_PATH=/products
XHS_CREATE_PATH=/products/create
XHS_UPDATE_PATH=/products/update
XHS_QUERY_PATH=/publish/status
DOUYIN_CLIENT_ID=
DOUYIN_CLIENT_SECRET=
DOUYIN_OAUTH_AUTHORIZE_URL=
DOUYIN_OAUTH_TOKEN_URL=
DOUYIN_OAUTH_REDIRECT_URI=
DOUYIN_API_BASE_URL=
DOUYIN_SYNC_PATH=/products
DOUYIN_CREATE_PATH=/products/create
DOUYIN_UPDATE_PATH=/products/update
DOUYIN_QUERY_PATH=/publish/status
PLATFORM_RULE_SYNC_MANIFEST_URL=
PLATFORM_RULE_SYNC_SIGNING_SECRET=
PLATFORM_RULE_SYNC_INTERVAL_HOURS=24
# Optional reviewed JSON-path response mapping for social APIs. Leave empty
# until the platform's documented payload and mapping evidence are approved.
XHS_ITEMS_PATH=
XHS_REMOTE_ID_PATH=
XHS_TITLE_PATH=
XHS_DESCRIPTION_PATH=
