NODE_ENV=development
# 仅本机 development/test 可使用 local；staging/preview/production 必须使用 strict。
AUTH_ENFORCEMENT=local
# HMAC key used only to fingerprint session IDs; never reuse OIDC or API tokens.
SESSION_ID_HASH_SECRET=replace-with-32-byte-secret
PORT=8787
# Production API auth: JSON map of opaque bearer token -> permitted workspaces.
# Example: {"replace-with-secret":["ws_demo"]}; inject via secret manager.
API_AUTH_TOKENS={}
# Managed ops auth: set OPS_AUTH_MODE=oidc in production and inject this secret
# into the SSO gateway and API.
OPS_AUTH_MODE=bearer
OIDC_PROXY_SIGNING_SECRET=
# Shared callback base/template. `/v1/oauth/callback` automatically appends
# the platform; `{platform}` is also supported. Per-platform values override it.
PUBLIC_OAUTH_REDIRECT_URI=
WORKER_API_BASE_URL=
WORKER_API_TOKEN=
DATABASE_URL=memory://local
# Production/staging should run migrations as a separate owner role and set
# this to false for the least-privileged API/worker database role.
RUN_MIGRATIONS_ON_STARTUP=true
REDIS_URL=memory://local
API_RATE_LIMIT_PER_MINUTE=120
OPS_API_RATE_LIMIT_PER_MINUTE=600
PLUGIN_WRITE_ENABLED=false
MODEL_PROVIDER=fake
# All text, image, vision and video traffic must use this HTTPS relay.
# Direct provider endpoints/keys are intentionally unsupported.
MODEL_RELAY_BASE_URL=
MODEL_RELAY_API_KEY=
# Optional audited fallback when the relay receipt has usage but no cost_cny.
# The relay must expose HTTPS /api/pricing and /api/status snapshots.
MODEL_RELAY_PRICING_DERIVATION_ENABLED=false
MODEL_RELAY_PRICING_GROUP=
# 可选：视频使用不同计费分组 Token；未设置时回退到 MODEL_RELAY_API_KEY。
VIDEO_MODEL_RELAY_API_KEY=
MODEL_RPM_LIMIT=
MODEL_TPM_LIMIT=
MODEL_DAILY_CNY_LIMIT=
AI_MODEL=
AI_TIMEOUT_MS=90000
# Hard per-request budgets. Invalid values fail closed instead of disabling the limit.
AI_MAX_INPUT_TOKENS=12000
AI_MAX_OUTPUT_TOKENS=2500
IMAGE_MODEL=
IMAGE_EDIT_MODEL=
OCR_MODEL=
VIDEO_MODEL=
VIDEO_GENERATION_PATH=/videos/generations
VIDEO_STATUS_PATH=/videos/status
VIDEO_TIMEOUT_MS=180000
IMAGE_TIMEOUT_MS=120000
IMAGE_SIZE=1024x1024
IMAGE_QUALITY=medium
# Use b64_json by default so the API can persist the result to object storage.
IMAGE_RESPONSE_FORMAT=b64_json
IMAGE_OUTPUT_FORMAT=png
# Billing/payment. `fixture` is local-only; production must use official provider APIs and signed callbacks.
PAYMENT_MODE=fixture
PAYMENT_CALLBACK_BASE_URL=
PAYMENT_PROVIDER_CHECKOUT_API_URL=
PAYMENT_PROVIDER_QUERY_API_URL=
PAYMENT_PROVIDER_REFUND_API_URL=
PAYMENT_PROVIDER_API_KEY=
PAYMENT_PROVIDER_MERCHANT_ID=
# 支付宝/微信原生商户私钥和证书只配置在独立支付网关，不进入本服务。
# Optional internal cost rates; never expose provider keys or raw billing data to merchants.
AI_PRICE_CNY_PER_1K_INPUT_TOKENS=
AI_PRICE_CNY_PER_1K_OUTPUT_TOKENS=
IMAGE_PRICE_CNY_PER_IMAGE=
JD_AUTH_ENABLED=false
JD_READ_ENABLED=false
JD_WRITE_ENABLED=false
TAOBAO_AUTH_ENABLED=false
TAOBAO_READ_ENABLED=false
TAOBAO_WRITE_ENABLED=false
TMALL_AUTH_ENABLED=false
TMALL_READ_ENABLED=false
TMALL_WRITE_ENABLED=false
PDD_AUTH_ENABLED=false
PDD_READ_ENABLED=false
PDD_WRITE_ENABLED=false
XHS_AUTH_ENABLED=false
XHS_READ_ENABLED=false
XHS_WRITE_ENABLED=false
DOUYIN_AUTH_ENABLED=false
DOUYIN_READ_ENABLED=false
DOUYIN_WRITE_ENABLED=false
CONNECTOR_FIXTURE_MODE=false
VAULT_ADDR=
VAULT_TOKEN=
VAULT_KV_MOUNT=secret
VAULT_NAMESPACE=
VAULT_CREDENTIAL_PATH_PREFIX=merchant-marketing
JD_APP_KEY=
JD_APP_SECRET=
JD_OAUTH_AUTHORIZE_URL=
JD_OAUTH_TOKEN_URL=
JD_OAUTH_REDIRECT_URI=
JD_API_BASE_URL=
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_OAUTH_AUTHORIZE_URL=
