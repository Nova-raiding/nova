<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.merchant.codex.api</string>
  <!-- Replace __REPO_ROOT__ with the absolute path to your checkout, and
       __HOME__ / __USER__ with the account that will run the agent. -->
  <key>WorkingDirectory</key><string>__REPO_ROOT__</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/opt/node@22/bin/node</string>
    <string>--import</string>
    <string>__REPO_ROOT__/node_modules/tsx/dist/loader.mjs</string>
    <string>__REPO_ROOT__/scripts/start-api-launchagent.mjs</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>__HOME__</string>
    <key>USER</key><string>__USER__</string>
    <key>NODE_ENV</key><string>development</string>
    <key>CONNECTOR_FIXTURE_MODE</key><string>true</string>
    <key>PLUGIN_WRITE_ENABLED</key><string>true</string>
    <key>API_AUTH_TOKENS</key><string>{"local-dev-token":{"workspaces":["ws_demo"],"roles":["merchant"]}}</string>
    <key>PORT</key><string>8790</string>
    <key>PATH</key><string>/opt/homebrew/opt/node@22/bin:/usr/bin:/bin</string>
  </dict>
  <key>KeepAlive</key><true/>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/tmp/merchant-codex-api.out.log</string>
  <key>StandardErrorPath</key><string>/tmp/merchant-codex-api.err.log</string>
</dict>
</plist>
