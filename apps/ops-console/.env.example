# Local development against infra/local/docker-compose.yml API.
# Operator console uses the platform account/password login. Bearer tokens are
# reserved for internal service-to-service calls and are never entered here.
VITE_API_BASE=http://127.0.0.1:8787
VITE_API_PROXY_TARGET=http://127.0.0.1:8787
VITE_OPS_AUTH_MODE=password

# Managed deployments: enterprise SSO entry and optional account request page.
# Do not point these at the API unless the gateway implements the full OIDC flow.
# VITE_OPS_LOGIN_URL=https://sso.example.com/oauth2/authorize
# VITE_OPS_REGISTER_URL=https://sso.example.com/request-access

# Production builds ignore local mode and always use the OIDC gateway session.
# Production deployment should override the API origin and use:
# VITE_API_BASE=https://mcp.example.com
# VITE_OPS_AUTH_MODE=oidc
