# Local development against infra/local/docker-compose.yml API.
# Operator console uses the platform account/password login. Bearer tokens are
# reserved for internal service-to-service calls and are never entered here.
VITE_API_BASE=http://127.0.0.1:8787
VITE_API_PROXY_TARGET=http://127.0.0.1:8787
VITE_OPS_AUTH_MODE=password

# Production and local deployments use the same platform account/password flow.
# VITE_API_BASE=https://mcp.example.com
# VITE_OPS_AUTH_MODE=password
